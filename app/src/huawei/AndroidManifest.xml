<?xml version="1.0" encoding="utf-8"?>
<!--
  Huawei AppGallery channel.
  The app must not download or install its own updates outside AppGallery
  (Huawei review guideline 3.9), and it must not request network access so it
  can be declared as a standalone/offline app. The github flavor keeps both.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:node="remove" />

    <application>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            tools:node="remove" />
    </application>
</manifest>
